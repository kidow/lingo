# OS
.DS_Store

# 디자인 논의용 임시 시각 자료
.visualstorming/

# 이미지 생성 원본 — 레포에는 변환 결과물만 들어간다 (spec.md §7)
.images/

# 도구가 흘리고 간 것
output.mp3
# audio make가 API 응답을 잠깐 떨궈 두는 자리
.audio-tmp/

# 발음. R2에 둔다 — 33,000개 476MB라 .git이 982MB까지 갔다 (AUDIO.md)
# 로컬 파일은 지우지 않는다: pnpm audio도 /debug도 파일을 직접 본다
public/audio/
# pnpm audio sync 가 찍는 도장. pnpm check가 이보다 새로운 mp3를 센다
.audio-synced

# 내려받은 사전(CC-CEDICT). 결과만 content/에 들어간다
.cache/

# content/*.json에서 갈라 구운 것. 언제나 다시 나오므로 커밋하지 않는다
# (scripts/pack.ts). pnpm dev·build가 먼저 만든다
public/content/

# Next.js
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo

# API 키. 절대 커밋하지 않는다
.env
.env.*
!.env.example
