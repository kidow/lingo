# 발음 생성용 xAI 키 (pnpm audio make)
XAI_API_KEY=

# 발음을 올릴 rclone 리모트 (pnpm audio sync)
#   rclone config → n → s3 → Cloudflare R2 로 리모트를 만든 뒤 여기에 적는다
R2_REMOTE=r2:lingo-audio

# 발음 파일의 공개 주소. **비어 있으면 public/audio/ 를 그대로 쓴다**
#   로컬은 비워 둔다. 배포 환경에만 넣는다
#   예: https://audio.lingo.example  또는  https://pub-xxxx.r2.dev
NEXT_PUBLIC_AUDIO_BASE=
