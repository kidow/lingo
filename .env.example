# 발음 생성용 xAI 키 (pnpm audio make)
XAI_API_KEY=

# 발음을 올릴 rclone 리모트 (pnpm audio sync). **필수다**
#   발음은 저장소에 없다 — .gitignore가 public/audio/ 를 막고 R2가 서빙한다 (AUDIO.md)
#   S3 호환이면 R2·B2·S3 무엇이든 된다
#   형식: 리모트이름:버킷    예) r2:lingo-audio
R2_REMOTE=

# R2 자격증명 (pnpm audio sync). **rclone config 를 안 쓸 때만 채운다**
#   rclone은 RCLONE_CONFIG_<리모트이름>_<항목> 환경변수를 설정 파일 대신 읽는다.
#   아래는 리모트 이름이 `r2`(위 R2_REMOTE=r2:...)일 때의 이름이다 —
#   이름을 바꾸면 여기 R2 자리도 같이 바꾼다
#
#   키 만들기: Cloudflare 대시보드 → R2 → API 토큰 → Object Read & Write
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
#   계정 ID는 R2 개요 화면 오른쪽에 있다
RCLONE_CONFIG_R2_ENDPOINT=https://<계정ID>.r2.cloudflarestorage.com
#   R2는 ACL을 받지 않는다. 공개 여부는 버킷의 공개 접근 설정으로 정한다
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true

# 발음 파일의 공개 주소. **비어 있으면 public/audio/ 를 그대로 쓴다**
#
#   로컬 — 비운다. public/audio/ 에 파일이 그대로 있으므로 R2를 탈 이유가 없다
#   배포 — Vercel 환경변수에 R2 공개 주소를 넣는다 (여기 말고 대시보드에)
#          예: https://pub-xxxx.r2.dev
#
#   빌드 때 값이 박힌다 — 배포 환경변수를 바꾸면 재배포해야 반영된다
NEXT_PUBLIC_AUDIO_BASE=
