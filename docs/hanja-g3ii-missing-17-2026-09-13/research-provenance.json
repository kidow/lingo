  "assessment": {
    "directFacts": [
      "실제 국내 교재의 발행사 모야랜드/저자유태중/ISBN이 확인된다.",
      "회사 자체 소개에 교육제품·서비스 개발·생산 및 도서·전자책 출판 이력이 있다.",
      "모야랜드의 대상3글자 페이지가 자기 도메인의 번호 도해를 교육이미지로 직접 포함한다.",
      "이용약관의 디지털 한자 이미지 정의와 회사의 사이트 콘텐츠 권리 주장이 해당 제공범위를 포괄한다."
    ],
    "supportedInference": "이 증거 조합은 해당 번호도해를 국내 한자교재 발행주체가 직접 제공하는1차 교육참고자료로 분류하는 데 근거가 된다. 단순한 출처불명 개인사이트로만 표현하면 새로 확인한 발행·제공 책임을 놓친다.",
    "notEstablished": [
      "대상 도해별 최초 창작자/삽화가",
      "대상 이미지별 제작·발행일",
      "특정 인쇄교재의 정확한 판/쪽수",
      "외부 자료를 전혀 사용하지 않았다는 증명",
      "한국 시험기관의 승인 또는 교과서 인정"
    ],
    "limitedNegativeObservation": "세 개별 페이지와 JPEG EXIF에서는 외부 원전·전재·다른 출판사 귀속 표시를 찾지 못했다. 이것이 외부 원전 부재의 증명은 아니다.",
