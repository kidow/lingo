+      <clipPath id={clipId+'-u6705-left'} clipPathUnits="userSpaceOnUse"><path ref={tailClip} d={frame.tailOutline}/></clipPath>
+      <mask id={clipId+'-u6705-composite'} maskUnits="userSpaceOnUse" x="0" y="0" width="100" height="100">
+        <g id={clipId+'-u6705-body-guide'} clipPath={'url(#'+clipId+'-u6705-body)'}><path ref={guide} d={segment.revealPath} fill="none" stroke="white" strokeWidth={14} strokeLinecap="butt" strokeLinejoin="miter" pathLength="1" strokeDasharray="0 2" strokeDashoffset={0}/><circle ref={startCap} cx="0" cy="0" r="0" fill="white"/><circle ref={endCap} cx="0" cy="0" r="0" fill="white"/></g>
+        <path ref={bodyFill} d={frame.bodyOutline} fill="white" visibility="hidden"/>
+        <g clipPath={'url(#'+clipId+'-u6705-left)'}><rect ref={tailRect} x={75.8} y={88.5} width={0} height={3} fill="white"/></g>
+      </mask>
+    </defs>
+    <path ref={ink} d={segment.outline} mask={'url(#'+clipId+'-u6705-composite)'} visibility="hidden"/>
+  </g>
+}

