+  return <g data-stroke-start-gate={policy.id} data-stroke-reveal-policy="original-left-u6705-composite" data-u6705-progress={String(frame.bodyProgress)} data-u6705-composite-progress={String(progress)} data-u6705-clip={clipId} data-stroke-reveal-progress={progress}>
