+    <path ref={bodyRef} id={clipId+'-u7c67-foot-body'} data-u7c67-foot-body="true" d={segment.outline} fill="white" fillRule="nonzero" stroke="none" clipPath={'url(#'+bodyId+')'} visibility="hidden" />
+   </mask>
+  </defs>
